    { "name": "Smart burst now", "short_name": "Smart burst", "url": "./?start=burst", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Night burst now", "short_name": "Night", "url": "./?start=night", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
