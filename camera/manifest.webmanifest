{
  "name": "PlateTrace Camera",
  "short_name": "PT Camera",
  "description": "Free camera for clearer license plate photos and videos, sent to PlateTrace to help investigators.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#000000",
